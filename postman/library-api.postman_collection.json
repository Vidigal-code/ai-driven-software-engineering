                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Access token and user returned', () => { pm.expect(body.accessToken).to.be.a('string'); pm.expect(body.user.id).to.be.a('string'); });",
                  "pm.environment.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
