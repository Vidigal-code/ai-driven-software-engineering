          ]
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean architecture smoke\",\n  \"author\": \"Library validation\",\n  \"isbn\": \"{{bookIsbn}}\",\n  \"publisher\": \"Demonstration\",\n  \"publicationYear\": 2020,\n  \"category\": \"Engineering\",\n  \"description\": \"Temporary record used by the Postman collection.\",\n  \"totalCopies\": 4,\n  \"availableCopies\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const prefix = `978${String(Date.now()).slice(-9)}`;",
                  "const sum = [...prefix].reduce((total, digit, index) => total + Number(digit) * (index % 2 === 0 ? 1 : 3), 0);",
                  "pm.environment.set('bookIsbn', `${prefix}${(10 - sum % 10) % 10}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('bookId', pm.response.json().id);",
                  "pm.test('ISBN normalized', () => pm.expect(pm.response.json().isbn).to.equal(pm.environment.get('bookIsbn')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List, filter and paginate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?page=0&size=10&sort=title,asc&category=Engineering&available=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "title,asc"
                },
                {
                  "key": "category",
                  "value": "Engineering"
                },
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
