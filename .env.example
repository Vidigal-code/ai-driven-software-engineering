# Generate local secrets with: node scripts/init-env.mjs
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
# Public frontend configuration is embedded at build time; rebuild after changing it.
VITE_API_BASE_URL=/api/v1
VITE_HEALTH_URL=/actuator/health
POSTGRES_PASSWORD=replace-with-a-generated-database-admin-password
APP_DB_NAME=library
APP_DB_USER=library_app
APP_DB_PASSWORD=replace-with-a-different-generated-application-password
DB_POOL_SIZE=10
MAX_PAGE_SIZE=100
RECENT_BOOKS_LIMIT=5
AUTH_MAX_ATTEMPTS=30
AUTH_RATE_WINDOW=PT1M
AUTH_RATE_CAPACITY=10000
JWT_SECRET=replace-with-base64-encoded-random-secret-of-at-least-32-bytes
JWT_ISSUER=library-api
JWT_AUDIENCE=library-web
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
OPENAPI_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Library Administrator
DEMO_DATA_ENABLED=false
SPRING_PROFILES_ACTIVE=
